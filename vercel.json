{
  "version": 2,
  "cleanUrls": true,
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ]
}

/*
  --- تعليمات النشر على Vercel لـ تطبيق يزل (YZL) ---
  
  1. الربط مع GitHub: قم برفع الكود إلى مستودع GitHub خاص بك.
  2. إنشاء مشروع جديد: في لوحة تحكم Vercel، اختر "Add New Project" ثم "Import" من GitHub.
  3. إعدادات البناء (Build Settings):
     - Framework Preset: Vite
     - Build Command: npm run build
     - Output Directory: dist
  4. المتغيرات البيئية (Environment Variables):
     - تأكد من إضافة كافة المتغيرات الموجودة في .env.example (مثل مفاتيح Firebase) في إعدادات Vercel.
  5. النشر: بمجرد الضغط على "Deploy"، سيتولى Vercel بناء التطبيق وتطبيقه باستخدام هذا الملف.
  
  ملاحظة حول هذا الملف (vercel.json):
  - قسم rewrites: يضمن توجيه كافة الروابط إلى index.html لدعم React Router (SPA).
  - قسم headers: يضيف طبقات أمان (Security Headers) لحماية المستخدمين والبيانات من الهجمات الشائعة.
*/
